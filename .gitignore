Chirp3-HD.json
nod_para_series_correlation_*.json
docs/bug-audit-*.md
# 研究・診断用スクリプト（セットアップ系は追跡継続）
scripts/*
# 環境構築に必要なものだけ許可する（他は解析・実験用のローカルスクリプト）
!scripts/setup_env.ps1
!scripts/setup_nemotron_venv.ps1
!scripts/setup_qwen3_tts_venv.ps1
!scripts/setup_irodori_venv.ps1
# .sh 版も必須。engine_manager の _platform_script が POSIX ではこちらを探すので、
# 追跡していないとクローンした Linux/macOS で専用 venv 系 3 エンジンが
# 「このプラットフォーム向けが未提供」として飛ばされる。
!scripts/setup_nemotron_venv.sh
!scripts/setup_qwen3_tts_venv.sh
!scripts/setup_irodori_venv.sh
!scripts/start_qwen3_asr.ps1
!scripts/stop_qwen3_asr.ps1
!scripts/start_qt_docker.ps1
!scripts/verify_sherpa_import.py
!scripts/setup_assets.ps1
!scripts/extract_web_ui_manifest.py
# README のターンテイキングの図（docs/img/turn-taking-*.svg）を作り直す。
!scripts/make_turn_taking_figure.py
!scripts/setup_assets.sh
# Qwen3-ASR ONNX の fp32 / 1.7B は GitHub に無い。setup_assets の
# Qwen3AsrOnnxFp32Model / Qwen3AsrOnnx17BModel が ModelScope 取得に使う。
!scripts/download_qwen3_onnx.py
!scripts/vendor_three.py
# カスタム sherpa-onnx のビルド一式。プリビルドを配布していない環境（他プラットフォーム、
# sherpa を上げたい保守作業）ではここから再現する必要があるので追跡する。
!scripts/upgrade_sherpa_onnx.ps1
!scripts/build_sherpa_prebuilt_linux.sh
# TTS=OFF ビルドで .pyd/.so から落ちるシンボルを __init__.py から外す。
# これが無いと import 時に必ず ImportError になるので、ビルドに必須。
!scripts/fix_sherpa_onnx_init.py
!scripts/patch_sherpa_nemo_max_symbols.py
!scripts/patch_sherpa_nemo_greedy_doublefeed.py
!scripts/patch_sherpa_nemo_mel_params.py
# Nemotron 前処理 ONNX の生成・読込と Windows ビルドに必要なスクリプト。
!scripts/patch_sherpa_nemo_preprocessor.py
!scripts/patch_sherpa_msvc_parallel.py
!scripts/export_nemotron_preprocessor_onnx.py
# sherpa_patches は patch_sherpa_nemo_greedy_doublefeed.py が読むテンプレート
# （#3785 より古い木に当てる .cc の差し替え元）。無いとクリーンクローンで
# カスタム sherpa のビルドが落ちるので追跡する。
!scripts/sherpa_patches
!scripts/sherpa_patches/**
# speech.cpp の CUDA 版をソースから作るときに ggml へ当てるパッチ（setup_assets.sh の build_speechcpp_cuda）
!scripts/speechcpp_patches
!scripts/speechcpp_patches/**
!scripts/patch_sherpa_nemo_online_normalize.py
tests/
backchannel_forms.txt
obs.py

