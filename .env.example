# MaAI-SDS のシークレット（このファイルをコピーして .env を作る。.env は Git 管理外）
# 値をコードや controller_config.json に直接書かないこと。

# --- Google Cloud（音声認識 chirp3-asr を使う場合。設定画面のエンジン一覧には出していない） ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# TTS の TEMPLATE で認証方式 bearer_env を使う場合のトークンの例。
# 読む変数の名前は、設定画面の「認証情報の環境変数」に書いたもの（ここに書いた名前と合わせる）。
GOOGLE_OAUTH_ACCESS_TOKEN=

# --- OpenAI（LLM backend = OpenAI の場合） ---
OPENAI_API_KEY=

# --- Cartesia（TTS = Cartesia-Realtime の場合） ---
CARTESIA_API_KEY=

# OBS WebSocket のパスワードは環境変数では渡さない。設定画面の「OBS録画設定」で入力する
# （controller_config.json に保存される）。

# --- 入力 WAV（Docker）。ホストのフォルダを /app/input_wav に載せる ---
# 未設定ならリポジトリの ./input_wav。Downloads などなら例えば:
# INPUT_WAV_HOST=C:/Users/<you>/Downloads
# INPUT_WAV_HOST=

# --- Docker のホスト側パス（docker-compose.yml が読む） ---
# MMDAgent-EX の素材。未設定なら ./mmdagent_assets。
# /app/mmdagent_assets へ読み取り専用でマウントされるため、MDF はホスト側で編集する。
# MMDAGENT_ASSETS_HOST=C:/MMDAgent-EX/example

# --- Docker + ホスト MMDAgent-EX の Plugin_Remote ポート ---
# web と Qt 用 orchestrator は同じ MMD bridge ポートを publish するため排他です。
# Qt 構成は `docker compose --profile qt up -d orchestrator` のようにサービスを
# 対象指定し、web と同時に起動しないでください。
# MDF の Plugin_Remote_Websocket_Port と同じ値にする（両 Enable=false の WebSocket モード）。
# MaAI-SDS 用の maai_sds.mdf（assets/mmdagent/maai_sds）は TCP が既定で、WebSocket にするときの例が
# Plugin_Remote_Websocket_Port=9001 なので、それに合わせてある。
MMDAGENT_REMOTE_WS_PORT=9001
# MDF の Plugin_Remote_Port と同じ値にする（EnableClient=true の TCP モード。maai_sds.mdf の既定は 39001）。
MMDAGENT_REMOTE_TCP_PORT=39001
# EnableServer=true ではポート publish は使わず、コンテナがホストの ListenPort へ接続する。

# --- Docker backend + native Qt ---
# Qt が接続するホスト側 JSON-line ポート。コンテナ側は 8765 固定です。
MAAI_SDS_QT_ORCHESTRATOR_PORT=8765
